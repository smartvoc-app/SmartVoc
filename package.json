{
  "name": "vokabeltrainer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "recht": "node scripts/gen-datenschutz.mjs",
    "build": "npm run recht && tsc --noEmit && vite build",
    "preview": "vite preview",
    "build:ios": "npm run recht && CAP_PLATFORM=ios tsc --noEmit && CAP_PLATFORM=ios vite build",
    "ios": "npm run build:ios && npx cap sync ios",
    "ios:open": "npx cap open ios",
    "icons": "node scripts/gen-icons.mjs",
    "texte": "node texte/sammle-texte.mjs && cd texte && node bau-texte.cjs"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.0",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.1",
    "@fontsource/hanken-grotesk": "^5.2.8",
    "@fontsource/patrick-hand": "^5.2.8",
    "@fontsource/source-serif-4": "^5.2.9",
    "@supabase/supabase-js": "^2.108.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ts-fsrs": "^5.4.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "docx": "^9.7.1",
    "sharp": "^0.35.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^1.3.0"
  }
}
