# Copy to .env.local and fill in from your Supabase project
# (Settings → Data API for the URL, Settings → API Keys for the key).
# Leaving these unset keeps the app fully local-first (no login, full
# offline use).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Public address of the deployed web version, with trailing slash.
# Only the iOS build needs it: an email link cannot return to
# capacitor://localhost, so the app sends password resets to the web
# version instead — same Supabase project, so the reset frees the account
# for both. In the browser this is ignored; the current origin is used.
# Must also be listed under Supabase → Authentication → URL Configuration.
VITE_WEB_URL=https://smartvoc.app/
